{
  "name": "streamfinder",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/url-state.mjs",
    "test:smoke": "node e2e/smoke.mjs",
    "test:a11y": "node e2e/a11y.mjs",
    "test:crew": "node e2e/crew-facet.mjs",
    "test:ux": "npm run test:e2e && npm run test:smoke && npm run test:crew && npm run test:a11y"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@vitest/browser-playwright": "^4.1.10",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vitest": "^4.1.10",
    "vitest-browser-svelte": "^3.0.0"
  },
  "dependencies": {
    "@sveltejs/adapter-static": "^3.0.10"
  }
}
