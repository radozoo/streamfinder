{"id":39810,"slug":"tip-toe-2026","title":"Tip Toe","title_en":null,"year":2026,"rating":86,"votes_count":19,"runtime_min":231,"age_rating":null,"title_type":"seriál","vod_date":"2026-05-31","plot":null,"poster":"https://image.pmgstatic.com/cache/resized/w140/files/images/film/posters/171/346/171346050_y057k7.png","backdrop":null,"trailer_youtube_id":null,"genres":["Drama"],"tags":["vražda","gay","nenávist","sousedi","coming out","homofobie"],"countries":["Velká Británie"],"directors":["Peter Hoar"],"actors":["David Morrissey","Alan Cumming","Elizabeth Berrington","Paul Rhys","Clare Calbraith","Pooky Quesnel","Denise Welch","Peter Caulfield","Ania Marson","Luyanda Unati Lewis-Nyawo"],"screenwriters":["Russell T. Davies"],"cinematographers":["Matt Gray"],"composers":["Sam Watts"],"reviews":[{"author":"petrsv","text":"Tento seriál trochu připomíná Years and Years z pera stejného scenáristy. A já jsem moc rád, že je tu někdo, kdo dokáže tak tvrdě zachytit realitu dneška s výhledem do budoucna. Ono to totiž není jen o tom ukázat Británii roku 2026, ale zároveň velké varování do budoucna (a samozřejmě ne jenom pro Británii, stačí se rozhlédnout doma). Poslední věty v posledním díle jsou naprosto výstižné - \"Ale co když jsme se spletli?\" Jen mám obavu, že si to moc lidí nepřipustí. Seriál by měla vysílat ČT v hlavním vysílacím čase!(28.06.2026)","stars":5}],"vods":[{"platform":"Channel 4","url":null}],"link":"https://www.csfd.cz/film/1854836-tip-toe/prehled/","root_id":1854836,"root_title_id":null,"root_title":null,"root_slug":null,"is_toplevel":true,"season_no":null,"episode_no":null,"season_count":1,"episode_count":5,"is_running":false,"cadence_days":1,"first_vod_date":"2026-06-07","last_vod_date":"2026-06-09","episodes":[{"season_no":null,"episode_no":3,"vod_date":"2026-06-07","title":"Episode 3 (E03)","platforms":["Channel 4"]},{"season_no":null,"episode_no":4,"vod_date":"2026-06-08","title":"Episode 4 (E04)","platforms":["Channel 4"]},{"season_no":null,"episode_no"