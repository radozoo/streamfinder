effrey Schecter","Ian Scott McGregor","David W. Thompson","James P. Engel","Tod Engle","Johnnie Mae","Joseph Riccobene","Mikey Post","Thomas Philip O'Neill","Bryant Carroll","McKenna Kerrigan","Tony Rossi","Jason Furlani","Steve Routman","Billy Smith","Matthew Lawler","Clark Carmichael","Jared Grimes","Ryan Dinning","Tracy Sallows","Moira Driscoll","Fiana Toibin","Nore Davis","Clayton James Mackay","Trampas Thompson","Marcus Garvey","Daniel Martin Berkey","Lori Hammel","Nicholas E. Calhoun","Melissa McMeekin","Barney Fitzpatrick","Bethany Kay","Kate Harpootlian","Thaddeus McCants","Malik J. Ali","Edmund Genest","Olli Haaskivi","James Ciccone","Saint Marino","John Harrington Bland","Tommar Wilson","Robert Emmet Lunney","Amadeo Fusca","Anthony J. Gallo","Gregory Dann","Eric Leviton","Devin Harjes","Shaun O'Hagan","Caroline Grossman","Matty Blake","Frank L. Messina","Dieter Riesle","Chloe Lenihan","Danny Wolohan","Joseph Tudisco","Regan Lutz","Deanna Dys","Jessica DiGiovanni","Martin Abrahams"],"screenwriters":["Howard Korder","Cristine Chambers","Steve Kornacki","Riccardo DiLoreto","Jennifer Ames","Steve Turner","David Flebotte","Margaret Nagle","David Matthews","Lawrence Konner","Diane Frolov","Andrew Schneider","Terence Winter","Paul Simms","Chris Haddock","Bathsheba Doran","Meg Jackson"],"cinematographers":["Stuart Dryburgh","Jonathan Freeman","David Franco","Kramer Morgenthau","Eric Moynier"],"composers":[],"reviews":[{"author":"PetrPan","text":"Seriál u kterého pravidelně zapomínám na čas a ráno si připadám jako prohibiční agent bez víry a mám chuť se zbičovat, abych se probudil. Mafiánštiny mám rád a dvojka Kmotra u mě pořád vede, nicméně tahle Scorseseho libůstka se vyšplhala na mém  pomyslném žebříčku, který jsem si nikdy nesestavil, hodně vysoko. HBO to prostě zase dokázalo a do světa se vyloupl seriál par excellence a já se s vášní sobě vlastní každý den vracím do Atlantic City 20. let ( mimochodem jsem poněkud prudérnější než verbal, tak nemohu napsat, že si u toho pravidelně denně honím, ale  třeba jednou tu odvahu najdu)(03.09.2013)","stars":5},{"author":"Davies182","text":"Seriáloví fanatici lačnící po další adrenalinové dramatické jízdě čelem vzad!Impériumperfektně vystihuje již jeho pilot, v nemž Scorsese pohodlně usadí diváka do sedadla stařičkého Fordu, a neuspěchanou okružní jízdou mu ukazuje krásy a špínu Atlantic City - a jede se hodně pomalu. Seriál je tak spíše maximálně věrohodným dokumentem mapujícím \"problematiku\" prohibice, snad se ani nesnaží dávat si nějaké vyšší ambice. Má to kouzlo, dechberoucí atmosféru, a moc nenutí ke shlédnutí dalších a dalších částí... Jenomže možná proto jeBoardwalk Empiretak jedinečný: vysněný svět fanoušků mafiánských příběhů, ke kterému si každý (ne)najde svou cestu a se slzou v oku si užívá řemeslně zpracovanou oddychovku.(24.12.2010)","stars":5},{"author":"k212","text":"+1 za zoufalý boj s vlastním pokrytectvím a fanatickou vírou agenta Van Aldena, který -byť na okraji vyprávění- strhává moji neustálou pozornost (nebudu zastírat, že to není zajímavým výkonem Michaela Shannona :) Ináč občas hustá a krvavá gangstoška, ondy zase pěknej sexuální hukot, jindy zas téměř muzikoš a koneckonců -s jistou dávkou nadsázky- i satira. 75%(06.02.2011)","stars":4}],"vods":[{"platform":"HBO Max","url":"https://www.hbomax.com/cz/en/shows/boardwalk-empire/369f71c8-bc34-4d3c-a594-3c413bb0ce4d"},{"platform":"Lepší.TV","url":"https://www.lepsi.tv/top_tv/serial/imperium-mafie-v-atlantic-city-online?utm_source=csfd&utm_content=csfd"}],"link":"https://www.csfd.cz/film/266512-imperium-mafie-v-atlantic-city/prehled/","csfd_id":266512,"root_id":266512,"root_title_id":null,"root_title":null,"root_slug":null,"is_toplevel":true,"season_no":null,"episode_no":null,"season_count":5,"episode_count":56,"is_running":false,"cadence_days":null,"first_vod_date":null,"last_vod_date":null,"episodes":[]}