o-slovenských divákov je zrejme stále nevyčerpaný. Čudujem sa, že to stále nejakú sledovanosť má a čudujem sa aj ak je to len backgroundový element v domácnosti. Podľa môjho názoru je vypnutá čierna obrazovka lepší doplnok pre atmosféru, ako tento a ďalšie podobné braky.(09.07.2025)","stars":null}],"vods":[{"platform":"prima+","url":"https://www.iprima.cz/serialy/zoo?utm_source=csfd&utm_medium=section_vod&utm_campaign=link_exchange"},{"platform":"Oneplay","url":"https://www.oneplay.cz/porad/18149-zoo"},{"platform":"Telly","url":"https://telly.cz/program/zoo/"},{"platform":"SledovaniTV","url":"https://sledovanitv.cz/epg/event/primalove:2026071957aa5d8397d7e5dc78cd3904ebf5778f"}],"link":"https://www.csfd.cz/film/1086988-zoo/prehled/","csfd_id":1086988,"root_id":1086988,"root_title_id":null,"root_title":null,"root_slug":null,"is_toplevel":true,"season_no":null,"episode_no":null,"season_count":4,"episode_count":224,"is_running":false,"cadence_days":null,"first_vod_date":null,"last_vod_date":null}