matographers":["Fred Murphy"],"composers":["David Buckley"],"reviews":[{"author":"kleopatra","text":"Čtvrtá série krapet ztratila dech nebo spíše směr. Po pár prvních dílech, kdy dík Kalindě a jejímu britskému Podfukáři Marcu Warrenovi sledujeme thriller, nás to odveze k auditu, bankrotu, kandidatuře, volbám … na teploměru nudy přesně v tomto pořadí, bohudík zůstává právničina stále ostrá jak břitva, i když někdy pochybuju, co je možné, ale co já vím o právu v USA a koláčích sledovanosti. Tu a tam se objevující Mamie Gummer je živoucím důkazem, že podoba ani okoukaná gesta nejsou nic a mámě Streepový nemůže čuchnout k ponožkám. No a Alicia je jako manželka na dvě věci, zato právnička je fakt Dobrá :).(22.10.2018)","stars":4}],"vods":[{"platform":"SkyShowtime","url":"https://tracking.affiliateport.eu/click?o=1756&a=8442&sub_id5=https%3A%2F%2Fwww.skyshowtime.com%2Fcz%2Fstream%2Ftv%2Fdobra-manzelka%2F71176834-9312-3686-af77-8f41e25ad3a3"},{"platform":"DAFilms","url":"https://dafilms.cz/film/10801-proces"}],"link":"https://www.csfd.cz/film/266687-dobra-manzelka/517391-serie-4/prehled/","csfd_id":517391,"root_id":266687,"root_title_id":1492426,"root_title":"Dobrá manželka","root_slug":"dobr-man-elka-2009","is_toplevel":false,"season_no":4,"episode_no":null}