u..trápne postavy, infantilnosť v konaní, kvázi hlbokomyseľné dialógy, citové problémy mačiek a psov..k tomu ako čerešnička na ananásovej hawaii pičivnucovaniekrížencahindu-zen-vúdú-palecvzadku, asi ako protipól kresťanskému origoš NCIS, ktoré však nikdenepretláčalokrížena stenách čimodleniesa pred výstrelom..fakt niekoho prekvapilo ukončenie..? ja volám \"Hallelujah!!\"..(01.08.2025)","stars":2}],"vods":[{"platform":"Oneplay","url":"https://www.oneplay.cz/porad/24977-namorni-vysetrovaci-sluzba-hawai"},{"platform":"SledovaniTV","url":"https://sledovanitv.cz/epg/event/axn:202607038e35e89e253d588b09d0f677ed6afc62"},{"platform":"Lepší.TV","url":"https://www.lepsi.tv/top_tv/serial/namorni-vysetrovaci-sluzba-hawaj-online?utm_source=csfd&utm_content=csfd"}],"link":"https://www.csfd.cz/film/1030033-namorni-vysetrovaci-sluzba-hawai/prehled/","csfd_id":1030033,"root_id":1030033,"root_title_id":null,"root_title":null,"root_slug":null,"is_toplevel":true,"season_no":null,"episode_no":null,"season_count":3,"episode_count":54,"is_running":false,"cadence_days":null,"first_vod_date":null,"last_vod_date":null}