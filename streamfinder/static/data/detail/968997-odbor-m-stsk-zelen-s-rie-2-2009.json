 bola asi návšteva z Venezuely. Pozerám ďalej.(06.09.2023)","stars":3}],"vods":[{"platform":"Prime Video","url":"https://www.primevideo.com/detail/amzn1.dv.gti.8ca9f773-fb17-a44e-e7a3-6e106b4d9411"}],"link":"https://www.csfd.cz/film/257154-odbor-mestske-zelene/517564-serie-2/prehled/","csfd_id":517564,"root_id":257154,"root_title_id":1492413,"root_title":"Odbor městské zeleně","root_slug":"odbor-m-stsk-zelen-2009","is_toplevel":false,"season_no":2,"episode_no":null}