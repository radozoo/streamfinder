andez","Sabrina Rössel","Julia Neumann","Sabine Leipert","Tim Krause","Horst Kummeth","Scarlett Kleint","Michael Illner","Stefanie Sycholt","Kirsten Peters","Beate Fraunholz","Svenja Rasocha","Jürgen Werner","Matthias Kiefersauer","Oliver Dieckmann","Annette Lober","Gerlind Becker"],"cinematographers":["Thomas Antoszczyk","Sven Kirsten","James Jacobs","Markus Fraunholz","Gero Lasnig","Fritz Seemann","Heinz-Dieter Sasse","Sebastian Wiegärtner","Bernd Neubauer","Hartmut Lange","Rainer Gutjahr","Nicolas Joray","Jochen Radermacher","Frank Brünner","Martin Stingl","Francisco Domínguez","Meinolf Schmitz","Thomas Etzold","Helge Peyker","Birgit Dierken","Uwe Schäfer","Jochen Stäblein","Daniel Bussmann","Sabine Berchter"],"composers":["Christoph Zirngibl","Richard Blackford","Karim Sebastian Elias","Gert Wilden jun.","Andreas Weidinger","Marius Ruhland","Andy Groll","Annette Focks","Martina Eisenreich","Alessandro Molinari"],"reviews":[{"author":"Dr.Marek","text":"Za mě nádherné příběhy, naprosto lidské, kupoeivu tam je i spousta opravdového hunoru, u kterého se člověk opravdu nasměje, lidé (především v novějších dílech) reagující naprosto přirozeně, příroda a okolí nádherné, žádný spěch, pozitivita náboj, krásní herci. Je to přesně to co tahle doba potřebuje.(13.05.2025)","stars":5},{"author":"duklak2","text":"Můžete namítat, můžete se smát, ale má to něco do sebe. Ano, v podstatě každý díl je na vlas stejný. Bohaté, hezké, upravené paničky se zamilují. Nádherné prostředí protkanými skalami a pobřežím. Dámy se pokochají. Já sleduji ob díl. Děkuji \"Ingo\":-). Nemyslím to nijak ironicky, ale mě to celkem baví. Není to sice průměr, něco hůře, ale jenom o malinko. Tímto tedy pěkné dvě hvězdy. Ti co hned dali \"odpad\", kolik jste viděly celých dílů? Hm?(12.05.2026)","stars":2}],"vods":[{"platform":"Oneplay","url":"https://www.oneplay.cz/film/25704-inga-lindstrom-laska-v-sandbergenu"},{"platform":"Telly","url":"https://telly.cz/program/inga-lindstrom/"},{"platform":"SledovaniTV","url":"https://sledovanitv.cz/epg/event/kinobarrandov:20260622bef3ad14e149ac751b74ec52612ba7c5"},{"platform":"Lepší.TV","url":"https://www.lepsi.tv/top_tv/serial/inga-lindstrom-zamilovani-doktori-online?utm_source=csfd&utm_content=csfd"}],"link":"https://www.csfd.cz/film/263020-inga-lindstromova/prehled/","csfd_id":263020,"root_id":263020,"root_title_id":null,"root_title":null,"root_slug":null,"is_toplevel":true,"season_no":null,"episode_no":null,"season_count":1,"episode_count":109,"is_running":false,"cadence_days":null,"first_vod_date":null,"last_vod_date":null,"episodes":[{"season_no":null,"episode_no":22,"vod_date":null,"title":"Láska v Sandbergenu (E22)","platforms":["Telly","Oneplay","SledovaniTV"]},{"season_no":null,"episode_no":29,"vod_date":null,"title":"Mia a její sestry (E29)","platforms":[]}]}