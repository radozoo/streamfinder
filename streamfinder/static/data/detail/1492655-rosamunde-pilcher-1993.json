off","Janina Hartwig","Andreas Hoppe","Eline Doenst","Antonia Bill","Nina Kronjäger","Charlotte Woolfe","Luke Allen-Gale","Berit Vander","Joerg Stadler","Stella Trimmer","Nina Peterson","Leni Speidel"],"screenwriters":["Martin Wilke","Gabriele Kister","Marlies Ewald","Silke Morgenroth","Marc Rosenberg","Christiane Sadlo","Barbara Engelke","Mónica Simon","Uschi Müller","Axel Plogstedt","Astrid Meyer-Gossler","Thomas Hernadi","Tom Maier","Johanna Halt","Jochen S. Franken","Herbert Kugler","Sonja Pauli","Uta Geiger-Berlet","Nikola Bock","Antje Bähr","Christine Hartmann","Michael Keusch","Susanne Hertel","Tim Krause","Christian Lyra","Barbara Piazza","Astrid Ruppert","Matthew Thomas","Nicole Walter-Lingen","David Wyles","Andrea Sixt","Swenja Karsten","Judith Feldman","Charlotte Drews-Bernstein","Andreas Bradler","Jennie Blackton","Rochus Bassauer","Elvira Bolz","John Goldsmith","Christine Heinlein","Karsten Rüter","Marc Hillefeld","Jerzy May","Lee Langley","Stefanie Sycholt","Dagmar Seume"],"cinematographers":["Marc Prill","Hartmut Lange","Heinz-Dieter Sasse","Michael Faust","Winfried Kleist","Holger Greiß","Franz Ritschel","James Jacobs","Sebastian Wiegärtner","Mike Gast","Bernd Neubauer","Axel de Roche","Michael Steinke","Viktor Růžička","Rolf Greim","Peter Badel","Egon Werdin","Meinolf Schmitz","Nicolas Joray","Georgij Pestov","Jochen Radermacher","James Aspinall","János Vecsernyés","Helge Peyker","Werner Adams","Stefan Motzek","Frank Brünner","Otto Kirchhoff","Frank Claus","Gernot Köhler","Martin Stingl","Simon Archer","Simon Kossoff","Tony Imi","David Marsh","Jochen Stäblein","Ralph Netzer","Markus Selikovsky","Clemens Messow","Vladimir Subotic","Alexander Sachs","Stefan Ditner","Frank Barbian","Thomas Schinz","Niklas J. Hoffmann","Enzo Brandner","Ralf M. Mendle"],"composers":["Richard Blackford","Andreas Weidinger","Jürgen Ecke","Stuart Hancock","Patrick Schmitz","Richard Hartley","Alan Parker","Jennie Muskett"],"reviews":[{"author":"zdeny99","text":"Pornoseriál pro ženské publikum se vším všudy, co do takového žánru patří (přepychové nemovitosti zpravidla blízko překrásného pobřeží, zajímaví, bohatí, krásní a překvapivě zpravidla osamělí muži, nádherná auta, život v luxusu). Vše je to tak umělé, snobské, ale přesto nádherné. A ze všeho nejkrásnější jsou zpravidla ty postarší ženy, které tu hrají hlavní role. Takové ty, tzv. femme fatale. [3296. hodnocení, 2. komentář, 21%, 202. nejhorší seriál](06.10.2021)","stars":3},{"author":"Ceberus","text":"Jsem nucen to vidět na pozadí, když hrávám karty s babičkou, fanynkou seriálu. Není to můj žánr, ale na druhou stranu je třeba uznat, že odpad to není. Nejsou tam hrubé chyby ve scénáři, v hereckých výkonech, v kameře, v kostýmech či lokalitách - lidi tomu dávají odpad zpravidla proto, že nesnáší ten žánr, ne jako hodnocení filmů jakožto produktů. Mou jednu hvězdu berte jako vyjádření, že odpad to není, ale je to osobní označení, že se na to ani nemám pokoušet dívat. 😉 Pokud jste fanoušci žánru, přimyslete si k mému hodnocení nejméně dvě další hvězdy, pro vás ostatní platí ta jedna.(27.12.2023)","stars":1},{"author":"ilonaho","text":"Jedna za panoramata...(16.12.2019)","stars":1}],"vods":[{"platform":"Oneplay","url":"https://www.oneplay.cz/porad/18151-rosamunde-pilcher-odkaz-lasky"},{"platform":"Telly","url":"https://telly.cz/program/rosamunde-pilcher/"},{"platform":"SledovaniTV","url":"https://sledovanitv.cz/epg/event/prima_star:2026072898acabb7d2deb2d3f5acd8bcc1933540"},{"platform":"Lepší.TV","url":"https://www.lepsi.tv/top_tv/serial/rosamunde-pilcher-online?utm_source=csfd&utm_content=csfd"}],"link":"https://www.csfd.cz/film/637817-rosamunde-pilcherova/prehled/","csfd_id":637817,"root_id":637817,"root_title_id":null,"root_title":null,"root_slug":null,"is_toplevel":true,"season_no":null,"episode_no":null,"season_count":1,"episode_count":165,"is_running":false,"cadence_days":null,"first_vod_date":null,"last_vod_date":null,"episodes":[{"season_no":null,"episode_no":58,"vod_date":null,"title":"Tak blízko nebi (E58)","platforms":["SledovaniTV"]},{"season_no":null,"episode_no":59,"vod_date":null,"title":"Odkaz lásky (E59)","platforms":["Oneplay"]}]}