o postavu neměl rád, ovšem tady ho tvůrci povýšili na überkreténa a spláchli tím jinak celkem slušnou sérii do záchodu…bez poslední epizody 70%, s ní 40%(12.09.2023)","stars":3}],"vods":[{"platform":"Netflix","url":"https://www.netflix.com/title/70153373"}],"link":"https://www.csfd.cz/film/68858-show-jerryho-seinfelda/577316-serie-7/prehled/","root_id":68858,"root_title_id":1492295,"root_title":"Show Jerryho Seinfelda","root_slug":"show-jerryho-seinfelda-1989","is_toplevel":false,"season_no":7,"episode_no":null}