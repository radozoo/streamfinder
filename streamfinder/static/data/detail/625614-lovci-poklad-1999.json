eh.(02.06.2015)","stars":null}],"vods":[{"platform":"Oneplay","url":"https://www.oneplay.cz/porad/17152-lovci-pokladu"},{"platform":"SledovaniTV","url":"https://sledovanitv.cz/epg/event/axnblack:20260602a0d6007d1e12c7088dc98af2168cf329"},{"platform":"Lepší.TV","url":"https://www.lepsi.tv/top_tv/serial/lovci-pokladu-online?utm_source=csfd&utm_content=csfd"}],"link":"https://www.csfd.cz/film/77264-lovci-pokladu/prehled/","root_id":77264,"root_title_id":null,"is_toplevel":true,"season_no":null,"episode_no":null,"season_count":3,"episode_count":66,"is_running":false,"cadence_days":null,"first_vod_date":null,"last_vod_date":null}