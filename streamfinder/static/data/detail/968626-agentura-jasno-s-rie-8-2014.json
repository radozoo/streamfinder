Billy Zane","Deon Richmond","Floriana Lima","Val Kilmer","Madison Smith","John Lacy","Kwasi Thomas","Anesha Bailey","Laiken Laverock","Robert Underwood","Ed Lover","Bernadette Beck","Eliza Faria"],"screenwriters":["Steve Franks","Todd Harthan","Andy Berman","Saladin K. Patterson","Carlos Jacott","James Roday Rodriguez","Kell Cahoon"],"cinematographers":["Scott Williams"],"composers":["Adam Cohen","John Robert Wood"],"reviews":[{"author":"Blazkowicz","text":"Důstojné rozloučení. Deset dílů s proměnlivou kvalitou je tak akorát. 4+*(10.07.2021)","stars":4},{"author":"Víteček","text":"Tohle už je jen parodie na starší Psych. Dobře to ilustruje díl, který je remakem jednoho z prvních dílů. Dělá si srandu z remaku a prý je to záměrně špatné. Jenže záměrně špatný díl je pořád špatný. Navíc si dělá srandu z toho, jak remaky zbytečně přidávají zbytečné zvraty a sám s takovým přichází, jenže takhle Psych už delší dobu funguje.  \nKaždý díl jede podle stejného schématu, kde postupně obviňují jednoho podezřelého za druhým, ten co se zdá být tutový také umře a tak pokračují dál, dokud jim nezbyde jediný podezřelý, který je přirozeně pachatelem. Takhle se jede ke konci každý díl. Žádné pozorování, psychický gimmick je už jen na překážku a případy jsou jenom stále stejnou kostřičkou pro vtípky.  \nSkončilo to přibližně o jeden a půl řady později než mělo.(14.04.2025)","stars":2}],"vods":[{"platform":"Prime Video","url":"https://www.primevideo.com/detail/amzn1.dv.gti.3ab09279-c827-1d41-da24-75e164d51d1b"}],"link":"https://www.csfd.cz/film/223682-agentura-jasno/577752-serie-8/prehled/","csfd_id":577752,"root_id":223682,"root_title_id":1492376,"root_title":"Agentura Jasno","root_slug":"agentura-jasno-2006","is_toplevel":false,"season_no":8,"episode_no":null}