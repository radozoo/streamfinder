r","účetnictví","talk show"],"countries":["USA"],"directors":["Matt Shakman","Gwyneth Horder-Payton","Nisha Ganatra","Richard Shepard"],"actors":["Kumail Nanjiani","Murray Bartlett","Juliette Lewis","Annaleigh Ashford","Zack Palmisano","Andrew Rannells","Robin de Jesus","Jack Laufer","Spencer Boldman","Ravi Kapoor","Will Peltz","Mona Sishodia","Michael Graceffa","Jacob Buckenmyer","Justin Cuomo","Yumarie Morales","Jack Schumacher","Maximilian Acevedo","Danny Axley","Parker Harris","Sri Chilukuri","Nancy De Mayo","Yuri Brown","Doreen Calderon","Robert Allen Mukes","Rachel Paulson","Leslie Augustine","Dan Stevens","Nicola Peltz","Mark Jacobson","Amos Glick","Sathya Jesudasson","Bradley Fisher","Quentin Plair","Lindsley Allen","Jonathan Erickson Eisley","Joseph Raymond Lucero","Marisa Van den Borre","Evan Jonigkeit","Van Epperson","Adam Ray","Jonny Cruz","Clint Carmichael","Cindera Che","Donna Pescow","Brighton Sharbino","Jackie Swanson","Jim Meskimen","Lucie Pohl","Christopher Amitrano","Matt Kaminsky","Kaiser Johnson","Eric Normington","Anthony Marciona","Joe Hall","Desiree Staples","Chris Rickett","Christopher Keks","Patrick Cage","Colby Lemmo","Khasan Brailsford","Frances Chewning","Keith Kuhl","Cyrus Hobbi","Shawn Patrick Clifford","Christine Heneise"],"screenwriters":["Robert Siegel","Rajiv Joseph","Annie Julia Wyman","Jacqui Rivera","Jenni Konner"],"cinematographers":["Paula Huidobro","Jimmy Lindsey"],"composers":["Siddhartha Khosla"],"reviews":[{"author":"marhoul","text":"V rytmu disca zdálky, zblízka! :) Chválím! Výborné! Skvěle obsazené, kvalitně zahrané, dokonalá dobová atmosféra, všichni vystajlovaní až osmdesátková hanba, scenář, režie, hudba taky top. Příběh jsem neznala, s chutí jsem si minisérii užila. Angažmá Juliette velmi potěšilo a co předvedl Anglán v úvodu, tož tak to je na nějakou cenu. Jdu do plných, sedlo mi.(16.01.2023)","stars":5},{"author":"klukluka","text":"Americký paničky se nechaly na začátku 80. let klátit přímo na tanečním parketu, aby vás jejich dcery o 20 let později posílaly do lochu za to, že jste jim přidrželi dveře od výtahu. USA nutně potřebují duševní hygienu, psychofarmaka to nezachránila, to už taky víme. Zároveň platí, že západní soudnictví ještě pořád zavírá do vězení psychicky zjevně nemocné lidi, minimálně tenhle filmovej Somon Steve Banerjee byl jasnej aspik a slušela by mu spíš léčebna- byť klidně doživotní. Líbilo se mi to hodně, je to po všech stránkách pestrá a výživná story.(30.01.2023)","stars":4},{"author":"Chrustyn","text":"Stylová osmdesatková atmoška pánského stripterového klubu, kde se děly velké věci. Z počátku to vtáhne ale více by to fungovalo jako celovečerák, který by se zaměřil jen na to skutečně zajímavé a nutné.(26.03.2023)","stars":3}],"vods":[{"platform":"Disney+","url":"https://srv.tunefindforfans.com/showads/track/srvclk.php?aid=100006796&lp=https%3A//www.disneyplus.com/en-cz/browse/entity-00f77d8e-bbe3-4523-a73e-5deb475a3e47"},{"platform":"Hulu","url":null}],"link":"https://www.csfd.cz/film/1106937-predstavujeme-vam-chippendales/prehled/","csfd_id":1106937,"root_id":1106937,"root_title_id":null,"root_title":null,"root_slug":null,"is_toplevel":true,"season_no":null,"episode_no":null,"season_count":1,"episode_count":8,"is_running":false,"cadence_days":7,"first_vod_date":"2022-11-29","last_vod_date":"2023-01-03","episodes":[{"season_no":null,"episode_no":3,"vod_date":"2022-11-29","title":"Velveeta (E03)","platforms":["Disney+","Hulu"]},{"season_no":null,"episode_no":4,"vod_date":"2022-12-06","title":"To je prostě byznys (E04)","platforms":["Disney+","Hulu"]},{"season_no":null,"episode_no":5,"vod_date":"2022-12-13","title":"Pijavice (E05)","platforms":["Disney+","Hulu"]},{"season_no":null,"episode_no":6,"vod_date":"2022-12-20","title":"31. února (E06)","platforms":["Disney+","Hulu"]},{"season_no":null,"episode_no":7,"vod_date":"2022-12-27","title":"Papír je papír (E07)","platforms":["Disney+","Hulu"]},{"season_no":null,"episode_no":8,"vod_date":"2023-01-03","tit