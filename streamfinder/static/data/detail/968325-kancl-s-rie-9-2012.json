 Jr.","Joan Cusack","Rachael Harris","Dakota Johnson","Sendhil Ramamurthy","Malcolm Barrett","Spencer Daniels","Jackie Debatin","Clifford Bañagale","Nancy Carell","Jennifer Celotta","Bill Hader","Seth Meyers","Steve Carell","Brent Forrester","Spencer John Olson","Claire Scanlon","Matt Sohn","Dan Sterling","Daniel Amerman","Sara Chase","Mark McGrath","Nick Cafero","Amelie Gillette","Kate Comer","Monique Kim","Michael Patrick McGill","Brey Chanadet","Mitch Poulos","Oliver Vaquer","Jonah Platt","Eli Vargas","Ameenah Kaplan","Ross Mackenzie","Bob Glouberman","Allison Silverman","John Phillips","Deonte Gordon","Peter A. Hulne","Stewart Skelton","Graham Wagner","Adam Lustick","Scot Robinson","John C. McLaughlin","Allison Jones","Mary Gillis"],"screenwriters":["Ricky Gervais","Stephen Merchant","Greg Daniels","Jonathan Greene","Brent Forrester","Dan Sterling","Carrie Kemper","Dan Greaney","Paul Lieberstein","Owen Ellickson","Tim McAuliffe","Niki Schwartz-Wright","Halsted Sullivan","Robert Padnick","Jonathan Green","Allison Silverman","Graham Wagner"],"cinematographers":["Matt Sohn"],"composers":[],"reviews":[{"author":"dr.horrible","text":"Takmer o dve triedy lepšie ako nepodarená ôsma séria. Veľa vecí opäť prepísknutých, snaha o návrat k téme Jim & Pam je navyše príliš okatá. Ale je to téma Jim & Pam. Funguje dokonca aj keď cítite, že je to umelé. Celá S09 je jak keby veľmi podarený pokus napodobniť série 01-07. Neni to už ono, ale je to veľmi fajn.(06.09.2023)","stars":4},{"author":"javlapippi","text":"Posledná séria a asi bol najvyšší čas to ukončiť. Dosť epizód hodne dobrých, zopár slabších. Väčšina osadenstva drží lajnu, akurát ústredný pár krízuje, Andy je stále menej znesiteľný, zaujímavé sú Dwightove farmárske udalosti a asi najvtipnejšia je trojka Angela-Oscar-senátor. Hodne otravné sú vstupy dokumentaristického štábu do deja, to bol dosť zúfalý pokus o oživenie. Hodne cameií, väčšinou od mne neznámych hercov a komikov (Roseanne bola dobrá). Posledné 2-3 epizódy už na môj vkus žmýkajú nostalgické city hodne cez hranu, ale tak to asi malo byť.(21.04.2023)","stars":3},{"author":"Streeper","text":"Poslední série fungovala vcelku dobře. Hezky to utíkalo, místy to bylo vtipné, něco se uzavřelo a snažili se to do konce seriálu příběhově popohnat. Líbily se mi hlavně záverečné epizody, které jsou věnované zakončení natáčení dokumentu, jsem ráda, že i tohle dohnali do konce. A samozřejmě svatba, na které se objevil Michael, to bylo prostě top.(13.10.2021)","stars":3}],"vods":[{"platform":"Netflix","url":"https://www.netflix.com/title/70286845"},{"platform":"Disney+","url":"https://srv.tunefindforfans.com/showads/track/srvclk.php?aid=100006796&lp=https%3A//www.disneyplus.com/en-cz/play/6782de53-4017-44ad-98e5-b3f6a0dc2573"},{"platform":"Prime Video","url":"https://www.primevideo.com/detail/amzn1.dv.gti.76a9f6fb-a9b0-1c19-900e-4f50d1eede24"},{"platform":"SkyShowtime","url":"https://tracking.affiliateport.eu/click?o=1756&a=8442&sub_id5=https%3A%2F%2Fwww.skyshowtime.com%2Fcz%2Fstream%2Ftv%2Fkancl%2F3ccdfdde-91cd-3021-93af-9337210a95da%2Fseasons%2F9%2Fepisodes%2F--episode-1%2F31a8367c-2e32-39b6-a776-afee4165fe05"},{"platform":"SledovaniTV","url":"https://sledovanitv.cz/epg/event/prima_show:202605133a90a3ec969a7f4ba77ea64f8a2b4e50"}],"link":"https://www.csfd.cz/film/198118-kancl/516662-serie-9/prehled/","csfd_id":516662,"root_id":198118,"root_title_id":256048,"root_title":"Kancl","root_slug":"kancl-2005","is_toplevel":false,"season_no":9,"episode_no":null}