iette Jeffers","JoBeth Williams","Bonita Friedericy","John Allen Nelson","Kayla DiVenere","Tom Fitzpatrick","Monica Garcia","Emily Skinner","Michelle Wong","Christophe Favre","Felix Avitia","Gita Reddy","Ken Takemoto","Melody Butiu","Jeremy Guskin","Brian Elerding","Jon Curry","Aaron Jennings","Creagen Dow","John Thaddeus","Paul Zies","Philip Smithey","Andy Cohen","David Kaufman","Ivan Shaw","Lance Patrick","Donnell Turner","Andra Petru","Michael Olifiers","Laura Owen","India King","Alisa Torres","Sylva Kelegian","Verda Bridges","Mike Jerome Putnam","Margaret Easley","Nick Toren","Matt Champagne","Roy Lee Jones","Hayes Hargrove","Lorry Goldman","Al Vicente","Shawn Kathryn Kane","Melissa Bickerton","Frank Ashmore","Jeff Marlow","William Mulligan","Jimmy Smagula","Shanelle Gray","Patrick Weil","Alistair Steel","David A. Garcia","Ashli Haynes","Gordon Vasquez","Michael Rodrick","John Deignan","Mark Fite","Nakia Secrest","Vivian Kerr","Jarrod Bunch","Riley Rose Critchlow","Dougald Park","Noshir Dalal","Matthew Florida","Christopher Wallinger","Leland Crooke","Ajgie Kirkland","Karole Foreman","Bill Dawes","Byron McIntyre","Jazz Raycole","Billy Smith","Edward Gelhaus","Tiffany Jeneen","Kenneth Chang","Cisco Reyes","Sean Donnellan","Iseluleko Ma'at El 0","Richard Wharton","Patrick O'Connor","Biff Wiff","Kevin Nichols","Tiwana Floyd","Monique Edwards","Alina Phelan","Benjamin Byron Davis","Mark Edward Smith","Maxwele D'Angelo","Andrew Lukich","Phyllis Lyons","Angela Bullock"],"screenwriters":["Dave Caplan","Jan Nash","Ron McGee","Alison Cross","Lisa Marie Petersen","Katie Wech","Charles Grant Craig","Sal Calleros","Elizabeth Benjamin","Julie Hébert","Lindsay Sturman","Tess Gerritsen","David Gould","Joel Fields","Michael Sardo","Kiersten Van Horne","Steve Lichtman","Blair Singer","Dan Hamamura","Matt MacLeod","Meredith Philpott","Darin Goldberg","Shelley Meals","Ken Hanes","Diana Mendez","Janet Tamaro","Antoinette Stella","Jeremy Svenson","Sam Lembeck","Dee Johnson","Linda McGibney"],"cinematographers":["Patrick Cady","Anthony Hardwick","Ronald Víctor García","Rob Sweeney","Peter B. Kowalski","Frank Perl","James S. Levine"],"composers":["James S. Levine"],"reviews":[{"author":"jasiska","text":"Vemi príjemná záležitosť, najmä vďaka sympatickým hlavným hrdinkám a ich bohovsky vtipným dialógom, ale aj vďaka vedľajším postavám a atraktívnemu bostonskému koloritu. Problém nastáva v tej kriminalistickej oblasti - patologička je nejak strašne veľa zapojená do vyšetrovania (očividne len zo scenáristických dôvodov) a niektoré prípady sú smiešne povrchné. A tie doznania zločincov! Čo je už každý vrah idiot? Také trápne dôkazy a všetci sa priznávajú...(23.01.2013)","stars":4},{"author":"tranquill","text":"Jedna z nejsympatičtějších dvojic z celé škály kriminálních seriálů. Takové spojení Beckettové a Kůstky. Není to o originálních případech a rafinovaných pointách. Ale o citlivě napsaných osobách, které žijí svým životem, který má nějaký vývoj, o příjemném humoru, o výborném herectví a v neposlední řadě o dvou krásných ženách :-)(22.07.2013)","stars":4},{"author":"eva.sa","text":"Od knižní předlohy Tess Geritsenové se to velmi liší, ale stejně jako knihy, i tohle se povedlo. Prvních pár dilů mi dělalo problém zvyknout si na postavu Maury - od té knižní se povahově dost liší, tam je spíše za intelektuální dámu, v seriálu zase za roztomilou intelektuální naivku. Ale zvykla jsem si, a s radostí koukám na kvalitní krimi seriál, kde nechybí napětí ani humor.(03.06.2012)","stars":4}],"vods":[{"platform":"Prime Video","url":"https://www.primevideo.com/detail/amzn1.dv.gti.30118b7c-13c6-42d7-874f-4cc7b72a734a"}],"link":"https://www.csfd.cz/film/279990-rizzoli-isles-vrazdy-na-pitevne/prehled/","csfd_id":279990,"root_id":279990,"root_title_id":null,"root_title":null,"root_slug":null,"is_toplevel":true,"season_no":null,"episode_no":null,"season_count":7,"episode_count":105,"is_running":false,"cadence_days":null,"first_vod_date":null,"last_vod_date":null,"epi