 žilách!Asi Stejný jako ,když si Latifa hraje na =(18.05.2022)","stars":1}],"vods":[{"platform":"Disney+","url":"https://srv.tunefindforfans.com/showads/track/srvclk.php?aid=100006796&lp=https%3A//www.disneyplus.com/en-cz/play/689c87b5-88d8-4b2c-9557-1a17f427ad18"},{"platform":"JOJ Play","url":"https://play.joj.sk/series/Vy0v9Nt5LpkkaX2ZSsan"},{"platform":"Telly","url":"https://telly.cz/program/zelenac/"},{"platform":"SledovaniTV","url":"https://sledovanitv.cz/epg/event/axnwhite:202606248154d0d7ab6e1560087b576d093f0202"},{"platform":"Lepší.TV","url":"https://www.lepsi.tv/top_tv/serial/zelenac-online?utm_source=csfd&utm_content=csfd"}],"link":"https://www.csfd.cz/film/620005-zelenac/1076097-serie-4/prehled/","csfd_id":1076097,"root_id":620005,"root_title_id":1645264,"root_title":"Zelenáč","root_slug":"zelen-2018","is_toplevel":false,"season_no":4,"episode_no":null}