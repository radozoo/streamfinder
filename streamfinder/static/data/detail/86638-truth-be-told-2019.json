ographers":["Nicole Hirsch Whitaker","Colin Watkinson","Russ T. Alsobrook","Elie Smolkin","Doug Emmett","Brendan Uegama","Itai Ne'eman","Tim Suhrstedt","Kevin McKnight"],"composers":["John Paesano"],"reviews":[{"author":"M.i.k.e","text":"podařená detektivka,která je trochu něco jako Odložené případy,jen mnohem lépe obsazená,zahraná a zrežírovaná.Tvůrci rozhodně nešetří překvapeními a když se začíná zdát,že se věci vyjasňují,přijde další zvrat a osobně jsem až do posledního dílu neměl jasnou představu co že se to vlastně stalo.Octavia Spencer je fajn,stejně jako Aaron Paul,ale oba jsou trochu ve stínu dvojrole Lizzy Caplan.Ta v krátké době opět exceluje v roli narušeného jedince a docela jí to svědčí..80%(20.01.2020)","stars":4},{"author":"zapalik","text":"Octavia udělá z každé postavy vymletou nesympatickou bestii bez charisma a aspoň špetky lidskosti. Jistě, scénář je slabý, zatímco první díky zaujaly, pak to šlo velmi dolů, ale když je strašná hlavní herečka, nepomůže nic. A ne, proti pleti nejsem zaujatý, touhle úchylkou netrpím...(11.05.2020)","stars":3},{"author":"Hitman_47","text":"Naprosto příšerná hloupost s nesmírně špatnými/nesympatickými a nelogicky se chovajícími postavami. Navíc je děj tak strašně moc čitelný, že to byla doslova bolest dokoukat do konce ...(09.02.2021)","stars":2}],"vods":[{"platform":"Apple TV","url":"https://srv.clickfuse.com/ads/adclkr.php?id=100006636&url=https%3A//tv.apple.com/cz/show/truth-be-told/umc.cmc.6hegr60w8pjyfcblgocjek7oo"},{"platform":"Canal+","url":"https://www.canalplus.cz/stream/series/truth-be-told/serie-1/epizoda-1/?utm_campaign=vod_content&utm_content=feed&utm_source=csfd&utm_medium=partner&utm_term="}],"link":"https://www.csfd.cz/film/756436-truth-be-told/prehled/","root_id":756436,"root_title_id":null,"root_title":null,"root_slug":null,"is_toplevel":true,"season_no":null,"episode_no":null,"season_count":3,"episode_count":28,"is_running":false,"cadence_days":7,"first_vod_date":"2019-12-13","last_vod_date":"2023-03