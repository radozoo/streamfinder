is Burkley","Al Hopson","Bert Madrid","Kathy O'Dare","Lou TIano","Donald Douglas","Max Showalter","Tom Lee McFadden","Albert Cole","Judy Kaye","Brett Hadley","Gene LeBell"],"screenwriters":["Jack Epps Jr.","Halsted Welles","Abby Mann","William P. McGivern","Michael I. Wagner","Burton Armus","Peter S. Fischer","Robert Foster","Bob Bralver","Gene R. Kearney","Albert Ruben","Joel Oliansky","Michael Kozoll","Joe Gores","Chester Krumholz","Rift Fournier","Charlene Bralver","Art Eisenson","Ross Teel","L.T. Bentwood","David Taylor","Joseph Polizzi","Donald P. Bellisario","Oliver Crawford","Robert W. Lenski","Jack Laird","Sean Baine","Anthony Spinner","James M. Miller","Steven W. Carabatsos","Alvin Boretz","Morton S. Fine","Dallas L. Barnes","James Bonnet","Mark Rodgers","Barry Trivers","Robert E. Swanson","Ray Brenner","Don Rene Patterson","George Bacos","Robert C. Dennis","Alvin Sapinsley","Mark Weingart","Robert Malcolm Young","Mark Rogers","Richard DeLong Adams","Jerrold Freedman","Robert Heverly","Dirk Wayne Summers"],"cinematographers":["Gerald Perry Finnerman","Vilis Lapenieks","John McPherson","Charles Correll","Frank Beascoechea","Robert E. Collins","Sol Negrin","John Elsenbach"],"composers":["Billy Goldenberg","John Cacavas","Kim Richmond"],"reviews":[{"author":"Moraldo","text":"Přiznávám.. Dlouho jsem mu nemohl přijít na chuť. Špína v ulicích, špína na lidech... A najednou se mi dostal pod kůži. Holohlavý detektiv v klobouku s lízátkem, jehož jsem si jako ústřední postavu zamiloval, stejně jako jeho humor. Ano přiznávám, mám tě rád Theo. Stejně jako dobové scény z ulic New Yorku naplněných širokými auty, jsi něco, o co tenhle svět postupně přichází. Reprezentuješ něco, co současná auta plná dotykových displayů s tříválcovými chcípáky pod kapotou nedokáží nikdy nahradit. A za to díky poručíku.(14.11.2016)","stars":5},{"author":"monolog","text":"Koudžak, Beng! Beng! říká ve filmu Falešná hra s Goldie Hawn postarší větnamský manželský pár, který se náhodou připlete do auta používaného výše zmíněnou divou k pronásledování  zločince. A je to pravda, Kojak je výborný seriál staré drsné školy. Kdo by ho neznal? Holohlavý poručík s chraptivým hlasem Miroslava Moravce a neopomenutelným lízátkem v puse.(23.01.2006)","stars":4},{"author":"Skuby47","text":"Kdepak jsem se to po letech při sledování televize znovu ocitla?  V čele vyšetřovatelů stojí neúplatná osobnost vzbuzující respekt, vyholená hlava, cigareta či lízátko v puse, široká nahrblá ramena a sametový hlas Miroslava Moravce. Co se prostředí týče, tak všude kolem telefonní budky, žluté taxíky, zločinci i kriminalisté v oblecích s kravatou ve velkých bourácích a k tomu archaické metody vyšetřování. Co se příběhů týče, tak je to především pouliční kriminalita a organizovaný zločin New Yorského podsvětí a staré dobré mafie k tomu, jenom té krve je tam na dnešní poměry málo. Nezapomenutelný seriál z mého mládí se vrátil, ale obávám se, že jen pro mne. Dnešní mládí přepne na jiný program.(12.06.2016)","stars":4}],"vods":[{"platform":"Oneplay","url":"https://www.oneplay.cz/porad/210964-kojak-iv"},{"platform":"Telly","url":"https://telly.cz/program/kojak/"},{"platform":"SledovaniTV","url":"https://sledovanitv.cz/epg/event/Seznam:20260515bd9de379480eac4b51de05c115028f2a"},{"platform":"Lepší.TV","url":"https://www.lepsi.tv/top_tv/serial/kojak-online?utm_source=csfd&utm_content=csfd"}],"link":"https://www.csfd.cz/film/69999-kojak/prehled/","root_id":69999,"root_title_id":null,"is_toplevel":true,"season_no":null,"episode_no":null,"season_count":5,"episode_count":118,"is_running":false,"cadence_days":null,"first_vod_date":null,"last_vod_date":null}